DATABASE_URL=postgresql+psycopg://usuario:contraseña@localhost:5432/mamunis_db
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# "desarrollo" (por defecto) o "produccion". En produccion se apagan /docs y /redoc
# y se exige HTTPS (Strict-Transport-Security).
# ENTORNO=produccion
# Para subir imagenes de productos. Se copia del panel de Cloudinary ("API environment variable").
# Es un secreto, como SECRET_KEY: no se sube al repo.
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
# Opcional. Por defecto permite http://localhost:5173 y http://localhost:3000 (desarrollo).
# En produccion, poner el dominio real del front:
# CORS_ORIGINS=["https://www.mamunis.com.ar"]
