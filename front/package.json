{
  "name": "mamunis-front",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "preview": "vite preview",
    "api:types": "openapi-typescript http://127.0.0.1:8000/openapi.json -o src/api/schema.d.ts",
